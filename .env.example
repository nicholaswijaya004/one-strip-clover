# ======= ONE STRIP CLOVER — environment config =======
# Copy file ini jadi .env lalu isi nilainya.

PORT=3000

#  Lokasi folder data (kode, setelan, template, log).
#  Kosongkan untuk memakai ./data. Di Railway, arahkan ke volume-mu,
#  mis. DATA_DIR=/app/data
DATA_DIR=

# --- Email fallback studio (SMTP apa saja) ---
# Gmail: aktifkan 2FA → buat "App Password" (Google Account → Security)
# Alternatif free tier: Brevo (300 email/hari) atau Resend (100/hari, 3rb/bulan)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=studiokamu@gmail.com
SMTP_PASS=app-password-16-huruf
#  SMTP_FROM = alamat yang TAMPIL sebagai pengirim.
#  Untuk Gmail harus SAMA dengan SMTP_USER (Gmail menolak alamat lain).
#  Email pesanan selalu dikirim dari alamat ini — alamat pembeli hanya
#  dicantumkan di isi email, dan dipakai sebagai tujuan tombol Reply.
SMTP_FROM=studiokamu@gmail.com
STUDIO_EMAIL=studiokamu@gmail.com

# --- Google Drive (OPSIONAL) — OAuth akun Gmail biasa ---
# Isi CLIENT_ID & CLIENT_SECRET dulu (dari console.cloud.google.com,
# OAuth client type "Desktop app"), lalu jalankan SEKALI:
#     node scripts/google-auth.js
# Script itu akan mencetak REFRESH_TOKEN dan DRIVE_FOLDER_ID → paste di bawah.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=

# Nama folder yang dibuat script setup (opsional)
DRIVE_FOLDER_NAME=One Strip Clover Uploads

# --- Isi lampiran email ---
# true  = kirim STRIP jadi + 4 foto asli (default, paling aman)
# false = kirim STRIP jadi saja (email lebih ringan)
# Catatan: kalau strip gagal dibuat, foto asli SELALU dikirim.
ATTACH_RAW_PHOTOS=true

# --- Batas pesanan studio per kode ---
# 1 kode = maksimal berapa kali "Kirim ke Studio"?
# Tiap pesanan = kerja manual + cetak + ongkir, jadi jangan terlalu besar.
MAX_STUDIO_SUBMISSIONS=1

#  Berapa perangkat yang boleh memakai satu kode (anti kode dibagikan).
#  Ini hanya NILAI AWAL — setelah server jalan, ubahlah dari halaman /admin
#  (berlaku langsung, tanpa restart).
#  2 = memberi ruang untuk pembeli yang pindah dari browser dalam aplikasi
#      (TikTok/Instagram) ke browser biasa. 1 = paling ketat.
MAX_DEVICES_PER_CODE=2

# --- Masa tenggang kode (anti "pembeli terkunci") ---
# Kode yang sudah ditukar masih bisa MEMULIHKAN sesi selama N jam.
# Melindungi pembeli yang refresh / ganti HP / cache-nya terhapus.
# Jatah pesanan studio tetap dihitung per kode, jadi ini tidak menambah biayamu.
# Isi 0 kalau mau perilaku sekali-pakai yang keras (tidak disarankan).
REDEEM_GRACE_HOURS=3

# --- Keamanan sesi premium ---
# Dipakai untuk menandatangani token premium. Isi teks acak panjang.
# Kalau kosong, token hangus tiap server restart.
SESSION_SECRET=ganti-dengan-teks-acak-panjang-sekali
# Lama sesi premium (jam)
SESSION_HOURS=3

# --- Halaman admin /admin & API otomasi ---
# Password untuk membuka http://localhost:3000/admin
# dan untuk header x-admin-key di /api/admin/*
# Bikin acak & panjang. JANGAN dibagikan.
ADMIN_KEY=ganti-dengan-kata-sandi-acak-panjang
