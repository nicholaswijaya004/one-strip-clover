{
  "name": "one-strip-clover",
  "version": "1.0.0",
  "description": "One Strip Clover — photobox digital dengan kode akses sekali pakai",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "codes": "node scripts/generate-codes.js",
    "test-email": "node scripts/test-email.js",
    "auth": "node scripts/google-auth.js",
    "logs": "node scripts/show-logs.js",
    "test": "node --test test/*.test.js",
    "backup": "node scripts/backup-codes.js",
    "cleanup": "node scripts/cleanup-data.js",
    "template": "node scripts/make-template.js",
    "sim": "node scripts/simulasi-browser.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-exclude=\"frontend-react/**\" --test-coverage-lines=85 --test-coverage-functions=85 --test-coverage-branches=70 test/*.test.js",
    "ci": "npm run lint && npm run typecheck && npm test && npm run test:coverage && npm run sim && npm run smoke",
    "lint": "eslint .",
    "typecheck": "tsc -p frontend-react/tsconfig.json",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^182.0.0",
    "nodemailer": "^10.0.10"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.65"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3"
  }
}
